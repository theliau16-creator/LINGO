{
  "permissions": {
    "allow": [
      "Bash(awk -F= '{print $1, \\(length\\($2\\)>0 ? \"SET\" : \"EMPTY\"\\)}' .env)",
      "Bash(awk -F= '{print $1, \\(length\\($2\\)>0 ? \"SET\" : \"EMPTY\"\\)}' .env.development)",
      "Bash(git init *)",
      "Bash(git add *)",
      "Bash(git rm *)",
      "Bash(git commit -q -m ' *)"
    ]
  }
}
