# Same Supabase project as the web app (src/../.env at the repo root).
# Public values only — URL + publishable/anon key. Never a service_role key
# or any other server secret: EXPO_PUBLIC_* variables are bundled into the
# client and are not private.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
