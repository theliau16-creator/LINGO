# Same Supabase project as the web app (src/../.env at the repo root).
# Public values only — URL + publishable/anon key. Never a service_role key
# or any other server secret: EXPO_PUBLIC_* variables are bundled into the
# client and are not private.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Base URL of the TanStack Start server that hosts src/routes/api/** (the
# HTTP endpoints for privileged operations — translation, quota, etc.).
# Simulator: http://localhost:8080 (matches .claude/launch.json at the repo
# root) reaches the host Mac directly. A physical device cannot resolve
# "localhost" to the host machine — use the Mac's LAN IP or a deployed URL.
EXPO_PUBLIC_API_URL=
